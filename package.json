{
    "name": "cesium-tools-fxt",
    "version": "1.2.1",
    "description": "Cesium 场景工具库：测量、绘制、通视/视域、坡向、雷达格点栅格等（支持 React / Vue / 纯 TS）",
    "type": "module",
    "license": "MIT",
    "main": "./dist/cesium-tools.umd.js",
    "module": "./dist/cesium-tools.es.js",
    "types": "./dist/cesium-tools.d.ts",
    "exports": {
        ".": {
            "types": "./dist/cesium-tools.d.ts",
            "import": "./dist/cesium-tools.es.js",
            "require": "./dist/cesium-tools.umd.js",
            "default": "./dist/cesium-tools.es.js"
        },
        "./core": {
            "types": "./dist/core.d.ts",
            "import": "./dist/core.es.js",
            "default": "./dist/core.es.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "import": "./dist/react.es.js",
            "default": "./dist/react.es.js"
        },
        "./vue": {
            "types": "./dist/vue.d.ts",
            "import": "./dist/vue.es.js",
            "default": "./dist/vue.es.js"
        }
    },
    "files": [
        "package.json",
        "README.md",
        "LICENSE",
        "dist"
    ],
    "sideEffects": false,
    "keywords": [
        "cesium",
        "gis",
        "3d",
        "measurement",
        "radar",
        "grid"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/supershunan/cesium-tools.git"
    },
    "bugs": {
        "url": "https://github.com/supershunan/cesium-tools/issues"
    },
    "homepage": "https://www.npmjs.com/package/cesium-tools-fxt",
    "scripts": {
        "dev": "vite",
        "build": "vite build --config vite.config.lib.ts && vite build --config vite.config.umd.ts",
        "typecheck": "tsc --noEmit -p tsconfig.lib.json",
        "typecheck:playground": "tsc --noEmit -p tsconfig.playground.json",
        "playground:check-data": "node scripts/check-playground-data.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "prepublishOnly": "npm run typecheck && npm run test && npm run build"
    },
    "peerDependencies": {
        "@turf/turf": "^7.0.0",
        "@zip.js/zip.js": "^2.8.11",
        "cesium": "^1.119.0",
        "d3-delaunay": "^6.0.4",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "vue": "^3.3.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "vue": {
            "optional": true
        }
    },
    "devDependencies": {
        "@turf/turf": "^7.0.0",
        "@types/d3-delaunay": "^6.0.4",
        "@types/geojson": "^7946.0.14",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@typescript-eslint/eslint-plugin": "^7.15.0",
        "@typescript-eslint/parser": "^7.15.0",
        "@vitejs/plugin-react": "^4.3.1",
        "@zip.js/zip.js": "^2.8.11",
        "cesium": "^1.136.0",
        "d3-delaunay": "^6.0.4",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-config-ts-fxt": "^1.0.1",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-react-refresh": "^0.4.7",
        "prettier": "3.3.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "typescript": "^5.2.2",
        "vite": "^5.3.4",
        "vite-plugin-dts": "^4.0.3",
        "vitest": "^2.1.9",
        "vue": "^3.5.40"
    },
    "dependencies": {
        "geographiclib-geodesic": "^2.2.0"
    }
}
