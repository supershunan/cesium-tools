{
    "name": "cesium-tools-fxt",
    "version": "2.0.0",
    "description": "框架无关的 Cesium 场景工具库：测量、绘制、通视/视域、坡向、雷达格点栅格等",
    "type": "module",
    "license": "MIT",
    "main": "./dist/cesium-tools.umd.cjs",
    "module": "./dist/cesium-tools.es.js",
    "types": "./dist/cesium-tools.d.ts",
    "exports": {
        ".": {
            "types": "./dist/cesium-tools.d.ts",
            "import": "./dist/cesium-tools.es.js",
            "require": "./dist/cesium-tools.umd.cjs",
            "default": "./dist/cesium-tools.es.js"
        }
    },
    "files": [
        "package.json",
        "README.md",
        "LICENSE",
        "dist"
    ],
    "sideEffects": false,
    "keywords": [
        "cesium",
        "gis",
        "3d",
        "measurement",
        "radar",
        "grid"
    ],
    "repository": {
        "type": "git",
        "url": "https://gitcode.com/mypattern/full-radar.git",
        "directory": "packages/common-utils"
    },
    "bugs": {
        "url": "https://gitcode.com/mypattern/full-radar/issues"
    },
    "homepage": "https://www.npmjs.com/package/cesium-tools-fxt",
    "scripts": {
        "dev": "vite",
        "build": "vite build --config vite.config.lib.ts && vite build --config vite.config.umd.ts",
        "typecheck": "tsc --noEmit -p tsconfig.lib.json",
        "typecheck:playground": "tsc --noEmit -p tsconfig.playground.json",
        "playground:check-data": "node scripts/check-playground-data.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "prepublishOnly": "npm run typecheck && npm run test && npm run build"
    },
    "peerDependencies": {
        "@turf/turf": "^7.0.0",
        "@zip.js/zip.js": "^2.8.11",
        "cesium": "^1.119.0"
    },
    "devDependencies": {
        "@turf/turf": "^7.0.0",
        "@types/geojson": "^7946.0.14",
        "@typescript-eslint/eslint-plugin": "^7.15.0",
        "@typescript-eslint/parser": "^7.15.0",
        "@zip.js/zip.js": "^2.8.11",
        "cesium": "^1.136.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-config-ts-fxt": "^1.0.1",
        "prettier": "3.3.3",
        "typescript": "^5.2.2",
        "vite": "^5.3.4",
        "vite-plugin-dts": "^4.0.3",
        "vitest": "^2.1.9"
    },
    "dependencies": {
        "delaunator": "^5.1.0",
        "geographiclib-geodesic": "^2.2.0"
    }
}
